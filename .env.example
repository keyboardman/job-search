# Clé RapidAPI (JSearch + APEC API by API.SH)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# https://rapidapi.com/CaesarRodman/api/apec-api-by-api-sh
RAPIDAPI_KEY=

# Secret d’intégration Notion (ntn_… ou secret_…) — PAS l’URL de la base
# https://www.notion.so/my-integrations
# Voir docs/notion-sync.md et config/notion.json
NOTION_TOKEN=

# Optionnel : plafond de pages JSearch par query (1–20, défaut 1)
JSEARCH_NUM_PAGES=1

# Optionnel : timeout HTTP JSearch en ms (défaut 20000)
JSEARCH_TIMEOUT_MS=20000

# Optionnel : timeout HTTP Apec en ms (défaut 60000)
APEC_TIMEOUT_MS=60000

# Optionnel : pages Apec par query (1–5, défaut 1)
APEC_MAX_PAGES=1

# Optionnel : appels détail Apec /apec/v1/job par run (0–50, défaut 0)
APEC_MAX_DETAILS=0
